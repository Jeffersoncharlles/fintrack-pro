{
  "$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
  "extends": ["./packages/biome-config/base.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!coverage",
      "!**/.turbo",
      "!**/routeTree.gen.ts"
    ]
  }
}
